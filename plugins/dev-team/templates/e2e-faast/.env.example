# Copiar a .env (gitignored). El QA usa NOMBRES de variables, nunca valores en el chat.
BASE_URL=http://localhost:3000
API_URL=http://localhost:5000
OPENAPI_SPEC=../docs/openapi.yml
# Credenciales del usuario de pruebas (rol estandar) — sembradas por el DBA, idempotentes
QA_USER=qa.usuario@ejemplo.test
QA_PASS=cambiar
# Token para el barrido de contrato (qa-backend)
QA_TOKEN=
# Evidencia: SIEMPRE dentro de .coordination/ del proyecto (mono: ../ ; multi: ../ desde el repo {proyecto}-e2e)
EVIDENCE_DIR=../.coordination/evidence/_suite

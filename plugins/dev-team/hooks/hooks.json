{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/block-nested-delegation.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "(dev-team:)?(setup|product-owner|architect|ui-designer|lead|backend|frontend|dba|qa|qa-frontend|qa-backend|release-manager|infra|cybersec|pentester|appsec|cloudsec|tech-writer|ux-researcher|visual-designer|motion-designer|artist-3d|design-engineer)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/log-activity.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "(dev-team:)?(setup|product-owner|architect|ui-designer|lead|backend|frontend|dba|qa|qa-frontend|qa-backend|release-manager|infra|cybersec|pentester|appsec|cloudsec|tech-writer|ux-researcher|visual-designer|motion-designer|artist-3d|design-engineer)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/log-activity.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/inject-team-protocol.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/check-update.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}

# ─────────────────────────────────────────────────────────────────────────────
# parametros-tests.env — ÚNICO lugar donde se definen las versiones del stack
# de tests de la flota FaaST.
#
# Misma política que templates/parametros.env de la skill migrar-dotnet (ADR-017
# D2): subir xUnit, Testcontainers o el runner en toda la flota es editar ESTE
# archivo, no 40 .csproj.
#
# Uso:  set -a; . ./parametros-tests.env; set +a
#
# Versiones y licencias verificadas contra api.nuget.org el 2026-09-21.
# El porqué de cada elección: reference/03-stack-y-licencias.md
# ─────────────────────────────────────────────────────────────────────────────

# ---- TFM ---------------------------------------------------------------------
# El proyecto de test SIEMPRE usa el mismo TFM que la app (E-CS-03 de
# migrar-dotnet). Durante una migración sube en el MISMO commit.
# TFM_APP se completa por componente; TFM_DESTINO sale de la otra skill.
TFM_APP="net8.0"
TFM_DESTINO="net10.0"

# ---- Framework de test (decisión: xUnit v2, ver 03-stack §2.3) ---------------
XUNIT="2.9.3"                       # Apache-2.0  [V]
XUNIT_RUNNER_VS="3.1.5"             # existe 4.0.0 [V], sin rodaje en la flota
TEST_SDK="18.10.1"                  # Microsoft.NET.Test.Sdk

# ---- Aserciones --------------------------------------------------------------
# DEFAULT: Shouldly (BSD-3-Clause [V]).
# PROHIBIDO: FluentAssertions >= 8.0.0 — licencia COMERCIAL (Xceed) [V].
#            Repos que ya la usan: FIJAR en 7.2.0 (Apache-2.0 [V]), no subir.
SHOULDLY="4.3.0"
FLUENTASSERTIONS_MAX_LIBRE="7.2.0"
AWESOMEASSERTIONS="9.6.0"           # Apache-2.0 [V]; fork de FA 7 — requiere visto bueno

# ---- Dobles ------------------------------------------------------------------
# DEFAULT: NSubstitute. Repos que ya usan Moq: quedarse en Moq >= 4.20.2
# (SponsorLink estuvo en 4.20.0/4.20.1 y se retiró) [G].
NSUBSTITUTE="6.2.0"                 # BSD-3-Clause [V]
MOQ_MIN_SEGURO="4.20.2"

# ---- Snapshots y cobertura ---------------------------------------------------
VERIFY_XUNIT="31.12.5"              # MIT [V], asset net10.0 [V]
COVERLET_COLLECTOR="10.0.1"         # MIT [V]
REPORTGENERATOR="5.5.11"            # herramienta de CI [V]

# ---- Integración -------------------------------------------------------------
# Mvc.Testing va en la MAJOR DEL TFM de la app. No es opcional.
MVC_TESTING_NET8="8.0.31"           # [V]
MVC_TESTING_NET10="10.0.12"         # [V]

TESTCONTAINERS="4.15.0"             # MIT [V], asset net10.0 [V]  (+ .MySql, .MsSql)
RESPAWN="7.0.0"                     # [V]
WIREMOCK="2.17.0"                   # Apache-2.0 [V]
BOGUS="35.6.5"                      # licencia en archivo (MIT [G])

# ---- EF Core en los proyectos de test ---------------------------------------
# Sigue a la major de EF Core de la APP, no al TFM. En esta flota EF Core queda
# en la línea 9 bajo net10 por el techo de Pomelo (ADR-017 decisión (c)).
EF_TEST="9.0.20"                    # Microsoft.EntityFrameworkCore.Sqlite [V]
# Microsoft.EntityFrameworkCore.InMemory: NO SE USA (02-estrategia §4.3)

# ---- Imágenes de contenedor para Testcontainers ------------------------------
# Confirmar el tag exacto y los términos de uso de la imagen de SQL Server antes
# de meterla en CI [G].
IMG_MYSQL="mysql:8.0"
IMG_MSSQL="mcr.microsoft.com/mssql/server:2022-latest"

# ---- Identificación del componente -------------------------------------------
REPO=""                             # p.ej. micro-api-back
RAMA=""                             # p.ej. develop_docker_net10
PROYECTO=""                         # nombre base, p.ej. Cloud.Faast.Back
SLN=""                              # ruta del .sln
APP_CSPROJ=""                       # ruta del .csproj que se publica

# ---- Ambiente para la suite de CONTRATO (familia d) --------------------------
# NUNCA con valores acá. Se exportan a mano al correr la suite de contrato.
# Sin estas variables, esos tests se SALTEAN (nunca fallan, nunca corren).
#   QA_BASE_URL=""     ← solo un ambiente de QA. Nunca Puente/Demo/prod
#   QA_TOKEN=""        ← token de lectura, jamás versionado

# ---- Rutas de trabajo --------------------------------------------------------
COORD="${COORD:-}"          # ruta ABSOLUTA de la carpeta de coordinacion del proyecto (la indica el
                            # coordinador o config.json; NUNCA dentro de un repo). Sin valor: preguntar.
REPOS_DIR="${REPOS_DIR:-}"  # carpeta que contiene los clones de los repos. Sin valor: preguntar.
SALIDA="${COORD}/inventario/tests"   # informes y scaffold generado (NUNCA el repo)

# ─────────────────────────────────────────────────────────────────────────────
# parametros.env — ÚNICO lugar donde se define el destino de la migración.
#
# Toda la skill `migrar-dotnet` lee de acá. Cambiar el destino de la flota
# (net9 → net10 → net11) es editar ESTE archivo, no las plantillas ni los
# Dockerfile ni los workflows.
#
# Uso:  set -a; . ./parametros.env; set +a
# ─────────────────────────────────────────────────────────────────────────────

# ---- DESTINO (lo que decide el ADR-017) ------------------------------------
# TFM_DESTINO      valor exacto de <TargetFramework> en el csproj
# DOTNET_TAG       tag de imagen MCR (sdk/aspnet/runtime) — SIEMPRE = major.minor
# SDK_PIN          versión exacta del SDK para global.json (vacío = sin pin)
# SOPORTE_HASTA    fin de soporte del TFM destino (para el DoD y el ADR)
# TIPO_SOPORTE     LTS | STS
TFM_DESTINO="net10.0"
DOTNET_TAG="10.0"
SDK_PIN="10.0.100"
SOPORTE_HASTA="2028-11-14"
TIPO_SOPORTE="LTS"
LANG_VERSION="latest"

# Alternativa evaluada y descartada en ADR-017 (dejada acá para poder volver
# atrás sin tocar nada más que estas 5 líneas):
#   TFM_DESTINO="net9.0"; DOTNET_TAG="9.0"; SDK_PIN="9.0.100"
#   SOPORTE_HASTA="2026-11-10"; TIPO_SOPORTE="STS"
#
# Cuando .NET 11 salga GA (2026-11-10, STS, fin 2028-11-09) NO se adopta por
# defecto: la flota sigue el carril LTS. El próximo salto de flota es net12
# (LTS, nov-2027). Ver ADR-017 §6.

# ---- ORIGEN (se completa por componente, no es global) ---------------------
# Valores posibles observados en la flota FaaST:
#   netcoreapp3.0 | netcoreapp3.1 | net5.0 | net6.0 | net7.0 | net8.0 | net9.0
TFM_ORIGEN=""

# ---- Identificación del componente -----------------------------------------
REPO=""                    # nombre del repo en faast-app (= segmento <repo>)
RAMA_BASE="develop"        # rama de la que se corta la rama de migración
INSTANCIA="desa-pe"        # token único de ambiente (ADR-002 §4.2)
PROYECTO_PRINCIPAL=""      # ruta del .csproj que se publica
ASSEMBLY=""                # nombre del .dll de entrada (NO asumir)

# ---- Política de build ------------------------------------------------------
# WARN_AS_ERROR: "true" solo cuando el componente ya compila limpio; arrancar
# en "false" y endurecer al final (ver 03-plan-de-pruebas §1).
WARN_AS_ERROR="false"
NULLABLE="disable"         # NO activar nullable en una migración de runtime:
                           # es un cambio de código, no de plataforma.
IMPLICIT_USINGS="disable"  # idem: cambia la semántica de los `using` del repo.

# ---- Rutas de trabajo -------------------------------------------------------
COORD="${COORD:-}"          # ruta ABSOLUTA de la carpeta de coordinacion del proyecto (la indica el
                            # coordinador o config.json; NUNCA dentro de un repo). Sin valor: preguntar.
REPOS_DIR="${REPOS_DIR:-}"  # carpeta que contiene los clones de los repos. Sin valor: preguntar.
SALIDA="${COORD}/inventario/migracion"   # informes por componente

{
  "playwright": {
    "command": "npx",
    "args": [
      "-y",
      "@playwright/mcp@0.0.80",
      "--browser=chromium",
      "--caps=testing,devtools,vision",
      "--isolated",
      "--output-dir=${HOME}/.faast-mcp/mesa-servicios",
      "--test-id-attribute=data-testid",
      "--timeout-action=8000",
      "--timeout-navigation=45000",
      "--console-level=warning",
      "--ignore-https-errors"
    ]
  }
}
